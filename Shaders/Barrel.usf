// 屏幕UV弯曲函数：中间向内收缩，边缘向外扩张
// CurvatureStrength: 曲率强度,推荐值 0.1-0.5,值越大弯曲越明显
// AspectRatio: 屏幕宽高比 (Width/Height),默认1.0为正方形
float2 AdvancedCurveScreenUV(float2 UV, float CurvatureStrength = 0.1, float AspectRatio = 1.777)
{
	// 将UV从[0,1]转换到[-1,1]的中心坐标系
	float2 CenteredUV = (UV - 0.5) * 2.0;

	// 根据宽高比调整X坐标,保持正确的圆形曲率
	CenteredUV.x *= AspectRatio;

	// 计算距离屏幕中心的径向距离
	float RadialDistance = length(CenteredUV);

	// 使用平滑的曲率函数模拟曲面屏效果
	// 距离中心越远,向"内"弯曲的效果越明显
	float CurveFactor = 1.0 + CurvatureStrength * RadialDistance * RadialDistance;

	// 应用曲率变换:将UV向中心方向压缩
	float2 CurvedUV = CenteredUV / CurveFactor;

	// 还原X坐标的宽高比调整
	CurvedUV.x /= AspectRatio;

	// 转换回[0,1]的UV空间
	float2 FinalUV = CurvedUV * 0.5 + 0.5;

	// 边界处理:超出[0,1]范围的UV会被自然裁剪
	return FinalUV;
}
